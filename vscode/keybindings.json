[
  // --- Panes ---
  // Press Ctrl+B, release it, then the action key.
  // Focus
  {
    "key": "ctrl+b left",
    "command": "workbench.action.navigateLeft",
  },
  {
    "key": "ctrl+b down",
    "command": "workbench.action.navigateDown",
  },
  {
    "key": "ctrl+b right",
    "command": "workbench.action.navigateRight",
  },
  {
    "key": "ctrl+b up",
    "command": "workbench.action.navigateUp",
  },

  // Move editor
  {
    "key": "ctrl+b shift+left",
    "command": "workbench.action.moveEditorToLeftGroup",
    "when": "(!vim.mode || vim.mode == 'Normal') && editorTextFocus"
  },
  {
    "key": "ctrl+b shift+down",
    "command": "workbench.action.moveEditorToBelowGroup",
    "when": "(!vim.mode || vim.mode == 'Normal') && editorTextFocus"
  },
  {
    "key": "ctrl+b shift+right",
    "command": "workbench.action.moveEditorToRightGroup",
    "when": "(!vim.mode || vim.mode == 'Normal') && editorTextFocus"
  },
  {
    "key": "ctrl+b shift+up",
    "command": "workbench.action.moveEditorToAboveGroup",
    "when": "(!vim.mode || vim.mode == 'Normal') && editorTextFocus"
  },

  // Split
  {
    "key": "ctrl+b -",
    "command": "workbench.action.splitEditorDown",
    "when": "!terminalFocus"
  },
  // Shift+backslash types | on a US keyboard.
  {
    "key": "ctrl+b shift+\\",
    "command": "workbench.action.splitEditorRight",
    "when": "!terminalFocus"
  },
  // Panel terminal splits follow VS Code's panel orientation.
  {
    "key": "ctrl+b shift+\\",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus"
  },

  // Resize
  {
    "key": "ctrl+alt+left",
    "command": "workbench.action.decreaseViewWidth"
  },
  {
    "key": "ctrl+alt+right",
    "command": "workbench.action.increaseViewWidth"
  },
  {
    "key": "ctrl+alt+down",
    "command": "workbench.action.decreaseViewHeight"
  },
  {
    "key": "ctrl+alt+up",
    "command": "workbench.action.increaseViewHeight"
  },

  // --- Navigation History ---
  {
    "key": "ctrl+o",
    "command": "workbench.action.navigateBack"
  },
  {
    "key": "ctrl+i",
    "command": "workbench.action.navigateForward"
  },

  // --- Search ---
  {
    "key": "cmd+shift+R",
    "command": "workbench.action.quickTextSearch",
  },

  // --- File Explorer (Neo-tree conventions) ---
  // Open, expand, and find
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus",
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && explorerResourceIsFolder && !inputFocus",
  },
  {
    "key": "/",
    "command": "list.find",
    "when": "filesExplorerFocus && foldersViewVisible && !inputFocus"
  },

  // Create, rename, and delete
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },

  // Copy, cut, and paste
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !inputFocus",
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus",
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus",
  },

  // Open in split: s = right, S = below
  {
    "key": "s",
    "command": "runCommands",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus",
    "args": {
      "commands": [
        "workbench.action.newGroupRight",
        "explorer.openAndPassFocus"
      ]
    }
  },
  {
    "key": "shift+s",
    "command": "runCommands",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsFolder && !inputFocus",
    "args": {
      "commands": [
        "workbench.action.newGroupBelow",
        "explorer.openAndPassFocus"
      ]
    }
  }
]
